APP_ENV=production
DATABASE_URL=postgresql+psycopg://<USER>:<PASSWORD>@<RDS_HOST>:5432/<DATABASE>
JWT_SECRET_KEY=<SECRET>
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2
FRONTEND_ORIGIN=https://<FRONTEND_DOMAIN>

LLM_PROVIDER=openai
OPENAI_API_KEY=<SECRET>
LLM_MODEL=<MODEL>
EMBEDDING_MODEL=<MODEL>

VECTOR_STORE_TYPE=pgvector
AI_REQUEST_TIMEOUT_SECONDS=30
RAG_TOP_K=5
RAG_MAX_COSINE_DISTANCE=0.45
RAG_CHUNK_WORDS=220
RAG_CHUNK_OVERLAP_WORDS=40
