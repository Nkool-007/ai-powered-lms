# ==========================================================
# SmartLMS - Docker / Phase 7 Environment Template
# ==========================================================

COMPOSE_PROJECT_NAME=smartlms

# Published host ports
FRONTEND_PORT=5173
BACKEND_PORT=5000

# PostgreSQL
POSTGRES_USER=smartlms
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=ai_powered_lms
DATABASE_URL=postgresql+psycopg://smartlms:replace-with-a-strong-password@postgres:5432/ai_powered_lms

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=2

# Browser / CORS
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Phase 6 AI
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
VECTOR_STORE_TYPE=pgvector
AI_REQUEST_TIMEOUT_SECONDS=30

# RAG
RAG_TOP_K=5
RAG_MAX_COSINE_DISTANCE=0.45
RAG_CHUNK_WORDS=220
RAG_CHUNK_OVERLAP_WORDS=40
